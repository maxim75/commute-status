# Copy to .env in the project folder, or to ~/.config/commute-status/.env
TFNSW_API_KEY=your-tfnsw-api-key
# Optional:
# COMMUTE_STATION=Engadine Station
# COMMUTE_TOWARDS=Town Hall
# COMMUTE_TITLE=auto   # or full | compact | minimal
# COMMUTE_LINE_START=Waterfall Station   # map the line from here to place trains
# COMMUTE_RETURN_AFTER=14:00   # from then on: Town Hall -> Engadine; empty = never
# COMMUTE_RETURN_LINE_START=Bondi Junction Station
